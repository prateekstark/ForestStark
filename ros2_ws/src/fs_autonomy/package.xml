<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fs_autonomy</name>
  <version>0.1.0</version>
  <description>ForestStark autonomy: localization (EKF over GNSS, odometry, IMU), planting head action server, Katar spacing trigger and boom control, Jaal coverage fleet with tender logistics, Pahadi contour following with tool choice, tip-over stability and traction monitors, mission logging and RViz markers.</description>
  <maintainer email="garg.prateek@alumni.iitd.ac.in">ForestStark</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>fs_interfaces</exec_depend>
  <exec_depend>fs_gazebo</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
