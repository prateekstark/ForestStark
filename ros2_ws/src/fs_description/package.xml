<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fs_description</name>
  <version>0.1.0</version>
  <description>ForestStark robot models (xacro/URDF with Gazebo systems): A Katar tractor-trailer planter, B Jaal swerve-drive planter, C Pahadi articulated tracked planter.</description>
  <maintainer email="garg.prateek@alumni.iitd.ac.in">ForestStark</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>fs_gazebo</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
