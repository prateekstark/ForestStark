<?xml version="1.0"?>
<!--
  B · Jaal — electric platform with four independently steered wheels (fs::SwerveDrive), two rotary
  sapling drums, a Cartesian plug picker, and a rear planting head on a shuttle.
  base_link at the wheelbase centre, 0.38 m above ground (wheel axle height).

  Plant handling: each drum holds 4 tiers x 45 pockets. The drum turns the next full pocket to the
  pick window (+y). The picker (rail x, column z, reach y, two fingers) pulls the plug out and drops
  it into the funnel at x -1.2 m, which feeds the duckbill on the shuttle. After boring, the shuttle
  moves the duckbill over the hole. Visuals are the CAD meshes (cad/forest_cad/jaal.py).

  xacro jaal.urdf.xacro ns:=jaal_1 soil_map:=/abs/open_field.soilmap lidar:=true
-->
<robot name="jaal" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ns" default="jaal_1"/>
  <xacro:arg name="soil_map" default=""/>
  <xacro:arg name="lidar" default="true"/>
  <xacro:arg name="gnss_sigma" default="0.02"/>
  <xacro:arg name="inspect_cam" default="false"/>
  <xacro:property name="ns" value="$(arg ns)"/>
  <xacro:property name="R" value="jaal"/>
  <xacro:include filename="$(find fs_description)/urdf/common.xacro"/>

  <link name="base_link">
    <!-- 30 kWh LFP pack low in the body; payload half used -->
    <xacro:box_inertial m="1000" x="2.8" y="1.3" z="0.9"><origin xyz="0 0 0.28"/></xacro:box_inertial>
    <xacro:cbox xyz="0 0 0.22" size="2.8 1.3 0.45"/>
    <xacro:mesh_visual robot="${R}" link="base_link"/>
  </link>

  <xacro:macro name="module" params="tag x y">
    <joint name="steer_${tag}_joint" type="revolute">
      <parent link="base_link"/><child link="steer_${tag}_link"/>
      <origin xyz="${x} ${y} 0.25"/><axis xyz="0 0 1"/>
      <limit lower="-2.0" upper="2.0" effort="800" velocity="3.0"/><dynamics damping="5"/>
    </joint>
    <link name="steer_${tag}_link">
      <inertial><mass value="8"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
      <xacro:mesh_visual robot="${R}" link="steer_${tag}_link"/>
    </link>
    <xacro:wheel effort="900" name="wheel_${tag}" parent="steer_${tag}_link" xyz="0 0 -0.25" r="0.38" w="0.22" m="35" robot="${R}"/>
  </xacro:macro>
  <xacro:module tag="fl" x="0.95" y="0.83"/>
  <xacro:module tag="fr" x="0.95" y="-0.83"/>
  <xacro:module tag="rl" x="-0.95" y="0.83"/>
  <xacro:module tag="rr" x="-0.95" y="-0.83"/>

  <!-- ===================== sapling drums ===================== -->
  <xacro:macro name="drum" params="tag x">
    <joint name="drum_${tag}_joint" type="continuous">
      <parent link="base_link"/><child link="drum_${tag}_link"/>
      <origin xyz="${x} 0 0.5"/><axis xyz="0 0 1"/><limit effort="300" velocity="2"/><dynamics damping="5"/>
    </joint>
    <link name="drum_${tag}_link">
      <inertial><origin xyz="0 0 0.8"/><mass value="45"/><inertia ixx="12" iyy="12" izz="5" ixy="0" ixz="0" iyz="0"/></inertial>
      <xacro:mesh_visual robot="${R}" link="drum_${tag}_link"/>
    </link>
  </xacro:macro>
  <xacro:drum tag="f" x="0.55"/>
  <xacro:drum tag="r" x="-0.43"/>

  <!-- ===================== Cartesian plug picker ===================== -->
  <joint name="picker_x_joint" type="prismatic">
    <parent link="base_link"/><child link="picker_x_link"/>
    <origin xyz="0 0.62 2.1"/><axis xyz="1 0 0"/>
    <limit lower="-1.3" upper="0.8" effort="500" velocity="1.0"/><dynamics damping="20"/>
  </joint>
  <link name="picker_x_link">
    <inertial><origin xyz="0 0 -0.8"/><mass value="8"/><inertia ixx="1.7" iyy="1.7" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:mesh_visual robot="${R}" link="picker_x_link"/>
  </link>
  <joint name="picker_z_joint" type="prismatic">
    <parent link="picker_x_link"/><child link="picker_z_link"/>
    <origin xyz="0 0 -0.06"/><axis xyz="0 0 -1"/>
    <limit lower="0" upper="1.5" effort="300" velocity="1.0"/><dynamics damping="20"/>
  </joint>
  <link name="picker_z_link">
    <inertial><mass value="2"/><inertia ixx="0.005" iyy="0.005" izz="0.005" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:mesh_visual robot="${R}" link="picker_z_link"/>
  </link>
  <joint name="picker_y_joint" type="prismatic">
    <parent link="picker_z_link"/><child link="picker_y_link"/>
    <origin xyz="0 0.10 -0.06"/><axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.16" effort="200" velocity="0.5"/><dynamics damping="10"/>
  </joint>
  <link name="picker_y_link">
    <inertial><mass value="1"/><inertia ixx="0.003" iyy="0.003" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:mesh_visual robot="${R}" link="picker_y_link"/>
  </link>
  <xacro:macro name="h_finger" params="tag x axis">
    <joint name="finger_${tag}_joint" type="prismatic">
      <parent link="picker_y_link"/><child link="finger_${tag}_link"/>
      <origin xyz="${x} -0.125 0"/><axis xyz="${axis} 0 0"/>
      <limit lower="0" upper="0.014" effort="100" velocity="0.1"/><dynamics damping="2"/>
    </joint>
    <link name="finger_${tag}_link">
      <inertial><mass value="0.2"/><inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/></inertial>
      <xacro:mesh_visual robot="${R}" link="finger_${tag}_link"/>
    </link>
  </xacro:macro>
  <xacro:h_finger tag="a" x="0.03" axis="-1"/>
  <xacro:h_finger tag="b" x="-0.03" axis="1"/>

  <!-- ===================== rear planting head on a shuttle ===================== -->
  <joint name="shuttle_joint" type="prismatic">
    <parent link="base_link"/><child link="shuttle_link"/>
    <origin xyz="-1.65 0 0.92"/><axis xyz="1 0 0"/>
    <limit lower="-0.30" upper="0.02" effort="2000" velocity="0.6"/><dynamics damping="40"/>
  </joint>
  <link name="shuttle_link">
    <inertial><origin xyz="0.14 0 0"/><mass value="12"/><inertia ixx="0.1" iyy="0.4" izz="0.4" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:mesh_visual robot="${R}" link="shuttle_link"/>
  </link>
  <xacro:auger_head robot="${R}" parent="shuttle_link" xyz="0 0 0" length="0.72" stroke="1.1"/>
  <xacro:duckbill_head robot="${R}" parent="shuttle_link" xyz="0.28 0 -0.04" stroke="1.2" tamp_xyz="0.28 0 -0.18" tamp_stroke="1.2"/>

  <xacro:gnss ns="${ns}" parent="base_link" xyz="1.15 0 2.95" sigma="$(arg gnss_sigma)"/>
  <xacro:imu ns="${ns}" name="imu" parent="base_link" xyz="0 0 0.3"/>
  <xacro:if value="$(arg lidar)">
    <xacro:lidar2d ns="${ns}" parent="base_link" xyz="1.52 0 -0.08"/>  <!-- 0.30 m above ground: sees stumps -->
    <!-- rear: the planting head works at the back, where people walk up to it -->
    <xacro:lidar2d ns="${ns}" parent="base_link" xyz="-1.52 0 -0.08" rpy="0 0 3.14159" name="lidar_rear" topic="scan_rear"/>
  </xacro:if>
  <xacro:if value="$(arg inspect_cam)">
    <xacro:inspect_camera ns="${ns}" parent="base_link" xyz="-0.9 4.4 1.7" rpy="0 0.22 -1.5708"/>
  </xacro:if>

  <gazebo>
    <plugin filename="fs_swerve_drive_system" name="fs::SwerveDrive">
      <module><steer_joint>steer_fl_joint</steer_joint><wheel_joint>wheel_fl_joint</wheel_joint><x>0.95</x><y>0.83</y></module>
      <module><steer_joint>steer_fr_joint</steer_joint><wheel_joint>wheel_fr_joint</wheel_joint><x>0.95</x><y>-0.83</y></module>
      <module><steer_joint>steer_rl_joint</steer_joint><wheel_joint>wheel_rl_joint</wheel_joint><x>-0.95</x><y>0.83</y></module>
      <module><steer_joint>steer_rr_joint</steer_joint><wheel_joint>wheel_rr_joint</wheel_joint><x>-0.95</x><y>-0.83</y></module>
      <wheel_radius>0.38</wheel_radius>
      <topic>/model/${ns}/cmd_vel</topic><odom_topic>/model/${ns}/odometry</odom_topic>
      <odom_frame>${ns}/odom</odom_frame><base_frame>${ns}/base_link</base_frame>
      <max_speed>1.5</max_speed><max_accel>0.6</max_accel><max_yaw_rate>0.8</max_yaw_rate>
      <max_steer_rate>2.5</max_steer_rate><steer_p_gain>10</steer_p_gain>
    </plugin>
    <xacro:common_plugins ns="${ns}"/>
    <xacro:pos_controller ns="${ns}" joint="drum_f_joint" p="4" vmax="1.5" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="drum_r_joint" p="4" vmax="1.5" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="picker_x_joint" p="4" vmax="1.0" init="-1.2"/>
    <xacro:pos_controller ns="${ns}" joint="picker_z_joint" p="4" vmax="1.0" init="0.74"/>
    <xacro:pos_controller ns="${ns}" joint="picker_y_joint" p="5" vmax="0.4" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="finger_a_joint" p="6" vmax="0.08" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="finger_b_joint" p="6" vmax="0.08" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="shuttle_joint" p="4" vmax="0.6" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="duckbill_feed_joint" p="6" vmax="1.0" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="jaw_l_joint" p="6" vmax="2.0" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="jaw_r_joint" p="6" vmax="2.0" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="tamp_joint" p="6" vmax="1.0" init="0.0"/>
    <plugin filename="fs_terramechanics_system" name="fs::Terramechanics">
      <soil_map>$(arg soil_map)</soil_map>
      <topic>/model/${ns}/terramechanics</topic>
      <xacro:tm_wheel link="wheel_fl_link" r="0.38" b="0.22" l="0.19"/>
      <xacro:tm_wheel link="wheel_fr_link" r="0.38" b="0.22" l="0.19"/>
      <xacro:tm_wheel link="wheel_rl_link" r="0.38" b="0.22" l="0.19"/>
      <xacro:tm_wheel link="wheel_rr_link" r="0.38" b="0.22" l="0.19"/>
    </plugin>
    <plugin filename="fs_auger_soil_system" name="fs::AugerSoil">
      <soil_map>$(arg soil_map)</soil_map>
      <feed_joint>auger_feed_joint</feed_joint><spin_joint>auger_spin_joint</spin_joint>
      <tip_link>auger_link</tip_link><reaction_link>shuttle_link</reaction_link><tip_offset>0 0 -0.72</tip_offset><tool_axis>0 0 -1</tool_axis>
      <diameter>0.12</diameter><max_power>4000</max_power><efficiency>0.85</efficiency>
      <max_thrust>3000</max_thrust><max_feed>0.15</max_feed><rpm>140</rpm><max_stroke>1.1</max_stroke>
      <cmd_topic>/model/${ns}/auger/cmd</cmd_topic><status_topic>/model/${ns}/auger/status</status_topic>
    </plugin>
    <plugin filename="fs_plug_inventory_system" name="fs::PlugInventory">
      <xacro:plug_inventory_begin ns="${ns}"/>
      <carrier><name>drum_f</name><link>drum_f_link</link><ring><radius>0.41</radius><count>45</count><tiers>4</tiers><z0>0.117</z0><dz>0.4</dz></ring><fill>180</fill></carrier>
      <carrier><name>drum_r</name><link>drum_r_link</link><ring><radius>0.41</radius><count>45</count><tiers>4</tiers><z0>0.117</z0><dz>0.4</dz></ring><fill>180</fill></carrier>
      <holder><name>gripper</name><link>picker_y_link</link><xyz>0 -0.19 -0.06</xyz></holder>
      <holder><name>duckbill</name><link>duckbill_feed_link</link><xyz>0 0 -0.38</xyz></holder>
    </plugin>
  </gazebo>
</robot>
