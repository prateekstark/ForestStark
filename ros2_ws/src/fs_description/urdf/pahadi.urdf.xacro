<?xml version="1.0"?>
<!--
  C · Pahadi — two rubber-track modules joined by a yaw (+-30 deg) and roll (+-15 deg) articulation,
  with a 4-axis arm carrying an auger / percussive pick, plus a seed-ball injector.
  Each track is modelled as three road wheels (sphere collisions, fs::Terramechanics treats each
  as a 0.28 m x 0.37 m track segment). base_link = front module centre at road-wheel axle height.

  xacro pahadi.urdf.xacro ns:=pahadi soil_map:=/abs/hill_slope.soilmap
-->
<robot name="pahadi" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ns" default="pahadi"/>
  <xacro:arg name="soil_map" default=""/>
  <xacro:arg name="lidar" default="false"/>
  <xacro:arg name="gnss_sigma" default="0.02"/>
  <xacro:property name="ns" value="$(arg ns)"/>
  <xacro:property name="WR" value="0.21"/>
  <xacro:property name="L_UP" value="0.85"/>
  <xacro:property name="L_FORE" value="0.85"/>
  <xacro:include filename="$(find fs_description)/urdf/common.xacro"/>

  <xacro:macro name="track_visual" params="y">
    <xacro:vbox xyz="0 ${y} 0" size="1.1 0.28 0.42" material="fs_rubber"/>
    <visual><origin xyz="0.55 ${y} 0" rpy="${PI/2} 0 0"/><geometry><cylinder radius="0.21" length="0.28"/></geometry><material name="fs_rubber"/></visual>
    <visual><origin xyz="-0.55 ${y} 0" rpy="${PI/2} 0 0"/><geometry><cylinder radius="0.21" length="0.28"/></geometry><material name="fs_rubber"/></visual>
    <xacro:vbox xyz="0 ${y} 0.24" size="1.5 0.32 0.04" material="fs_graphite"/>
  </xacro:macro>

  <!-- ===================== front module ===================== -->
  <link name="base_link">
    <xacro:box_inertial m="480" x="1.3" y="1.3" z="0.6"><origin xyz="0 0 0.3"/></xacro:box_inertial>
    <xacro:cbox xyz="0 0 0.42" size="1.3 0.72 0.4"/>
    <xacro:vbox xyz="0 0 0.42" size="1.3 0.72 0.4" material="fs_yellow"/>
    <xacro:vbox xyz="0 0 0.63" size="1.32 0.74 0.05" material="fs_graphite"/>
    <xacro:vbox xyz="0.66 0.25 0.51" size="0.03 0.12 0.07" material="fs_glass"/>
    <xacro:vbox xyz="0.66 -0.25 0.51" size="0.03 0.12 0.07" material="fs_glass"/>
    <xacro:vcyl xyz="-0.45 -0.26 0.94" r="0.025" l="0.6" material="fs_graphite"/>
    <xacro:track_visual y="0.5"/>
    <xacro:track_visual y="-0.5"/>
  </link>
  <xacro:wheel name="fl1" parent="base_link" xyz="0.4 0.5 0" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="fl2" parent="base_link" xyz="0.0 0.5 0" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="fl3" parent="base_link" xyz="-0.4 0.5 0" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="fr1" parent="base_link" xyz="0.4 -0.5 0" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="fr2" parent="base_link" xyz="0.0 -0.5 0" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="fr3" parent="base_link" xyz="-0.4 -0.5 0" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>

  <!-- ===================== articulation (steered: +-30 deg yaw, passive +-15 deg roll) ===================== -->
  <joint name="artic_yaw_joint" type="revolute">
    <parent link="base_link"/><child link="artic_link"/>
    <origin xyz="-0.85 0 0.25"/><axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="20000" velocity="1"/><dynamics damping="50"/>
  </joint>
  <link name="artic_link">
    <inertial><mass value="5"/><inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:vcyl xyz="0 0 0" r="0.2" l="0.3" rpy="0 ${PI/2} 0" material="fs_graphite"/>
    <xacro:vcyl xyz="0 0 0.05" r="0.07" l="0.5" material="fs_steel"/>
  </link>
  <joint name="artic_roll_joint" type="revolute">
    <parent link="artic_link"/><child link="rear_link"/>
    <origin xyz="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-0.26" upper="0.26" effort="5000" velocity="1"/><dynamics damping="300"/>
  </joint>

  <!-- ===================== rear module (payload) ===================== -->
  <link name="rear_link">
    <!-- chassis 380 kg + 4 trays x 50 plugs + 75 L water (half of 150 L) + 30 kg seed balls -->
    <xacro:box_inertial m="535" x="1.4" y="1.3" z="0.8"><origin xyz="-0.86 0 0.21"/></xacro:box_inertial>
    <xacro:cbox xyz="-0.85 0 0.17" size="1.3 0.72 0.4"/>
    <xacro:vbox xyz="-0.85 0 0.17" size="1.3 0.72 0.4" material="fs_graphite"/>
    <xacro:vbox xyz="-0.85 0 0.38" size="1.32 0.74 0.05" material="fs_yellow"/>
    <xacro:vbox xyz="-0.47 0 0.65" size="0.42 0.55 0.05" material="fs_graphite"/>
    <xacro:vbox xyz="-0.47 0 0.69" size="0.4 0.5 0.04" material="fs_leaf"/>
    <xacro:vbox xyz="-0.91 0 0.65" size="0.42 0.55 0.05" material="fs_graphite"/>
    <xacro:vbox xyz="-0.91 0 0.69" size="0.4 0.5 0.04" material="fs_leaf"/>
    <xacro:vbox xyz="-0.47 0 1.07" size="0.42 0.55 0.05" material="fs_graphite"/>
    <xacro:vbox xyz="-0.47 0 1.11" size="0.4 0.5 0.04" material="fs_leaf"/>
    <xacro:vbox xyz="-0.91 0 1.07" size="0.42 0.55 0.05" material="fs_graphite"/>
    <xacro:vbox xyz="-0.91 0 1.11" size="0.4 0.5 0.04" material="fs_leaf"/>
    <xacro:vbox xyz="-0.69 0 1.47" size="0.95 0.66 0.02" material="fs_shade"/>
    <xacro:vcyl xyz="-1.32 0 0.81" r="0.18" l="0.42" material="fs_orange"/>
    <xacro:vcyl xyz="-1.32 0 1.1" r="0.05" l="0.09" material="fs_orange"/>
    <xacro:macro name="rear_track_visual" params="y">
      <xacro:vbox xyz="-0.85 ${y} -0.25" size="1.1 0.28 0.42" material="fs_rubber"/>
      <xacro:vbox xyz="-0.85 ${y} -0.01" size="1.5 0.32 0.04" material="fs_graphite"/>
    </xacro:macro>
    <xacro:rear_track_visual y="0.5"/>
    <xacro:rear_track_visual y="-0.5"/>
  </link>
  <xacro:wheel name="rl1" parent="rear_link" xyz="-0.45 0.5 -0.25" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="rl2" parent="rear_link" xyz="-0.85 0.5 -0.25" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="rl3" parent="rear_link" xyz="-1.25 0.5 -0.25" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="rr1" parent="rear_link" xyz="-0.45 -0.5 -0.25" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="rr2" parent="rear_link" xyz="-0.85 -0.5 -0.25" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>
  <xacro:wheel name="rr3" parent="rear_link" xyz="-1.25 -0.5 -0.25" r="${WR}" w="0.28" m="12" shape="sphere" rim="fs_steel"/>

  <!-- ===================== 4-axis arm ===================== -->
  <joint name="arm_base_joint" type="fixed"><parent link="base_link"/><child link="arm_base_link"/><origin xyz="0.25 0 0.65"/></joint>
  <link name="arm_base_link">
    <inertial><mass value="10"/><inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:vcyl xyz="0 0 0.04" r="0.14" l="0.08" material="fs_graphite"/>
  </link>
  <joint name="arm_yaw_joint" type="revolute">
    <parent link="arm_base_link"/><child link="arm_yaw_link"/>
    <origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-2.9" upper="2.9" effort="3000" velocity="1.2"/><dynamics damping="20"/>
  </joint>
  <link name="arm_yaw_link">
    <inertial><origin xyz="0 0 0.07"/><mass value="15"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:vbox xyz="0 0 0.07" size="0.16 0.14 0.16" material="fs_yellow"/>
  </link>
  <joint name="arm_shoulder_joint" type="revolute">
    <parent link="arm_yaw_link"/><child link="arm_upper_link"/>
    <origin xyz="0 0 0.12"/><axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="4000" velocity="1.0"/><dynamics damping="20"/>
  </joint>
  <link name="arm_upper_link">
    <inertial><origin xyz="${L_UP/2} 0 0"/><mass value="20"/><inertia ixx="0.05" iyy="1.2" izz="1.2" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:vcyl xyz="0 0 0" r="0.07" l="0.2" rpy="${PI/2} 0 0" material="fs_graphite"/>
    <xacro:vbox xyz="${L_UP/2} 0 0" size="${L_UP} 0.09 0.11" material="fs_yellow"/>
  </link>
  <joint name="arm_elbow_joint" type="revolute">
    <parent link="arm_upper_link"/><child link="arm_fore_link"/>
    <origin xyz="${L_UP} 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="2.9" effort="3000" velocity="1.2"/><dynamics damping="15"/>
  </joint>
  <link name="arm_fore_link">
    <inertial><origin xyz="${L_FORE/2} 0 0"/><mass value="15"/><inertia ixx="0.04" iyy="0.9" izz="0.9" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:vcyl xyz="0 0 0" r="0.06" l="0.18" rpy="${PI/2} 0 0" material="fs_graphite"/>
    <xacro:vbox xyz="${L_FORE/2} 0 0" size="${L_FORE} 0.08 0.09" material="fs_yellow"/>
  </link>
  <joint name="arm_wrist_joint" type="revolute">
    <parent link="arm_fore_link"/><child link="arm_wrist_link"/>
    <origin xyz="${L_FORE} 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="2.9" effort="2000" velocity="1.5"/><dynamics damping="10"/>
  </joint>
  <link name="arm_wrist_link">
    <inertial><origin xyz="0.07 0 0"/><mass value="8"/><inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/></inertial>
    <xacro:vcyl xyz="0 0 0" r="0.05" l="0.15" rpy="${PI/2} 0 0" material="fs_graphite"/>
    <xacro:vbox xyz="0.07 0 0" size="0.14 0.12 0.12" material="fs_graphite"/>
  </link>
  <xacro:auger_head parent="arm_wrist_link" xyz="0.14 0 0" length="0.36" diameter="0.12" stroke="0.45"
                    feed_axis="1 0 0" spin_axis="1 0 0" shaft_rpy="0 ${PI/2} 0" shaft_dir="1 0 0"/>

  <!-- ===================== sensors ===================== -->
  <xacro:gnss ns="${ns}" parent="base_link" xyz="-0.45 -0.26 1.27" sigma="$(arg gnss_sigma)"/>
  <xacro:imu ns="${ns}" name="imu" parent="base_link" xyz="0 0 0.3"/>
  <xacro:imu ns="${ns}" name="imu_rear" parent="rear_link" xyz="-0.85 0 0.1"/>
  <xacro:if value="$(arg lidar)">
    <xacro:lidar2d ns="${ns}" parent="base_link" xyz="0.68 0 0.5"/>
  </xacro:if>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>fl1_joint</left_joint><left_joint>fl2_joint</left_joint><left_joint>fl3_joint</left_joint>
      <left_joint>rl1_joint</left_joint><left_joint>rl2_joint</left_joint><left_joint>rl3_joint</left_joint>
      <right_joint>fr1_joint</right_joint><right_joint>fr2_joint</right_joint><right_joint>fr3_joint</right_joint>
      <right_joint>rr1_joint</right_joint><right_joint>rr2_joint</right_joint><right_joint>rr3_joint</right_joint>
      <wheel_separation>1.0</wheel_separation><wheel_radius>${WR}</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_angular_acceleration>0.8</max_angular_acceleration><min_angular_acceleration>-0.8</min_angular_acceleration>
      <max_linear_velocity>0.7</max_linear_velocity><min_linear_velocity>-0.4</min_linear_velocity>
      <max_angular_velocity>0.6</max_angular_velocity><min_angular_velocity>-0.6</min_angular_velocity>
      <topic>/model/${ns}/cmd_vel</topic><odom_topic>/model/${ns}/odometry</odom_topic>
      <tf_topic>/model/${ns}/odometry_tf</tf_topic>
      <frame_id>${ns}/odom</frame_id><child_frame_id>${ns}/base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <xacro:common_plugins ns="${ns}"/>
    <!-- articulated steering: the navigator commands the yaw angle between the modules -->
    <xacro:pos_controller ns="${ns}" joint="artic_yaw_joint" p="3" vmax="0.4" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="arm_yaw_joint" p="3" vmax="0.9" init="0.0"/>
    <xacro:pos_controller ns="${ns}" joint="arm_shoulder_joint" p="3" vmax="0.8" init="-1.35"/>
    <xacro:pos_controller ns="${ns}" joint="arm_elbow_joint" p="3" vmax="0.9" init="2.6"/>
    <xacro:pos_controller ns="${ns}" joint="arm_wrist_joint" p="3" vmax="1.2" init="0.3"/>
    <plugin filename="fs_terramechanics_system" name="fs::Terramechanics">
      <soil_map>$(arg soil_map)</soil_map>
      <topic>/model/${ns}/terramechanics</topic>
      <contact_tolerance>0.06</contact_tolerance>
      <lateral_factor>0.9</lateral_factor>
      <xacro:tm_wheel link="fl1_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="fl2_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="fl3_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="fr1_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="fr2_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="fr3_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="rl1_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="rl2_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="rl3_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="rr1_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="rr2_link" r="${WR}" b="0.28" l="0.37"/>
      <xacro:tm_wheel link="rr3_link" r="${WR}" b="0.28" l="0.37"/>
    </plugin>
    <plugin filename="fs_auger_soil_system" name="fs::AugerSoil">
      <soil_map>$(arg soil_map)</soil_map>
      <feed_joint>auger_feed_joint</feed_joint><spin_joint>auger_spin_joint</spin_joint>
      <tip_link>auger_link</tip_link><tip_offset>0.36 0 0</tip_offset><tool_axis>1 0 0</tool_axis>
      <diameter>0.12</diameter><max_power>2000</max_power><efficiency>0.8</efficiency>
      <max_thrust>2500</max_thrust><max_feed>0.12</max_feed><rpm>110</rpm><max_stroke>0.45</max_stroke>
      <rock_energy>45</rock_energy><pick_efficiency>0.5</pick_efficiency>
      <cmd_topic>/model/${ns}/auger/cmd</cmd_topic><status_topic>/model/${ns}/auger/status</status_topic>
    </plugin>
  </gazebo>
</robot>
