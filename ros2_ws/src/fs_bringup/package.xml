<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fs_bringup</name>
  <version>0.1.0</version>
  <description>ForestStark launch files: Gazebo site + robot + bridge + autonomy for Katar (roadside), Jaal fleet (open field) and Pahadi (hill slope), with RViz layouts.</description>
  <maintainer email="garg.prateek@alumni.iitd.ac.in">ForestStark</maintainer>
  <license>Proprietary</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>fs_gazebo</exec_depend>
  <exec_depend>fs_description</exec_depend>
  <exec_depend>fs_autonomy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
