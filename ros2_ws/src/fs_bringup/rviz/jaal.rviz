Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Cell Size: 1
    Plane Cell Count: 120
    Color: 160; 160; 164
    Alpha: 0.3
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Site survey
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/site
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Mission
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/mission
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Planted
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/plants
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Stability
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/stability
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Safety
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/safety
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Enabled: true
    Name: jaal_1
    Alpha: 1
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /jaal_1/robot_description
    TF Prefix: jaal_1
    Visual Enabled: true
    Collision Enabled: false
    Value: true
  - Class: rviz_default_plugins/Odometry
    Enabled: true
    Name: jaal_1 estimate
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /jaal_1/localization/odom
    Keep: 200
    Position Tolerance: 0.3
    Angle Tolerance: 0.5
    Shape:
      Value: Arrow
      Color: 227; 165; 20
      Alpha: 1
      Shaft Length: 0.8
      Shaft Radius: 0.05
      Head Length: 0.3
      Head Radius: 0.12
    Covariance:
      Value: false
    Value: true
  - Class: rviz_default_plugins/LaserScan
    Enabled: true
    Name: jaal_1 lidar
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /jaal_1/scan
    Size (m): 0.06
    Style: Flat Squares
    Color Transformer: FlatColor
    Color: 255; 85; 0
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Enabled: true
    Name: jaal_2
    Alpha: 1
