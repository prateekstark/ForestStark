Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Cell Size: 1
    Plane Cell Count: 120
    Color: 160; 160; 164
    Alpha: 0.3
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Site survey
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/site
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Mission
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/mission
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Planted
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/plants
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Stability
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /viz/stability
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Enabled: true
    Name: pahadi
    Alpha: 1
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pahadi/robot_description
    TF Prefix: pahadi
    Visual Enabled: true
    Collision Enabled: false
    Value: true
  - Class: rviz_default_plugins/Odometry
    Enabled: true
    Name: pahadi estimate
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pahadi/localization/odom
    Keep: 200
    Position Tolerance: 0.3
    Angle Tolerance: 0.5
    Shape:
      Value: Arrow
      Color: 227; 165; 20
      Alpha: 1
      Shaft Length: 0.8
      Shaft Radius: 0.05
      Head Length: 0.3
      Head Radius: 0.12
    Covariance:
      Value: false
    Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 44; 41
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.75
      Yaw: 3.9
      Target Frame: pahadi/base_link
      Value: Orbit (rviz_default_plugins)
    Saved: null
Window Geometry:
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
