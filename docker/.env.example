# copy to docker/.env on the robot
ROBOT=katar              # katar | jaal | pahadi
NS=                      # robot name; jaal_1, jaal_2.. in a Jaal fleet
SITE=site.yaml           # surveyed site YAML in SITE_DIR (soil map beside it)
SITE_DIR=/data/site
LOG_DIR=/data/fs_logs
FLEET=                   # Jaal: jaal_1,jaal_2,jaal_3
FLEET_MANAGER=false      # true on the base-station PC
ROS_DOMAIN_ID=42
